{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "ggwave"
  ],
  "ios": {
    "iosModuleName": "NitroGgwave"
  },
  "android": {
    "androidNamespace": [
      "ggwave"
    ],
    "androidCxxLibName": "NitroGgwave"
  },
  "autolinking": {
    "Ggwave": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridGgwave"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "**/example"
  ]
}
